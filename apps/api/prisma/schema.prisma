// Schema for docs/specs/2026-08-28-01-auth-account-security.md (aspect A-002).
// Modeled on CZ_DIGITIZING_ARCHITECTURE.md § Database Schema (Users/Sessions/Audit Logs) plus
// the spec's proposed admin_permissions table. Deliberately scoped to only the tables this
// aspect owns — designs/orders/etc. belong to their own specs' migrations (docs/CLAUDE.md
// dependency-ordered build rule).

// Generated to a project-local path and imported by relative path (not the "@prisma/client"
// package name) everywhere in apps/api. In a pnpm workspace, "@prisma/client"'s own postinstall
// hook can't auto-locate a non-default-path schema (silently no-ops instead of erroring), and
// even once generation is wired up explicitly, Node's symlink-following module resolution can
// land the output and the package-name lookup in different places depending on what invoked
// `prisma generate` and from where — this sidesteps that whole class of bug outright.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
  freelancer
  moderator
}

enum UserStatus {
  active
  inactive
  suspended
}

// docs/specs/2026-08-28-01-auth-account-security.md §4 — derived default list (2026-08-31),
// covers the resource groups named across the other feature specs. Adding a module later is a
// non-breaking enum addition.
enum AdminModule {
  designs
  categories
  bundles
  orders
  quotes
  custom_requests
  faqs
  testimonials
  blog
  portfolio
  subscriptions
  credits
  notifications
  settings
}

enum AdminAccessLevel {
  read_only
  crud
}

model User {
  id               BigInt     @id @default(autoincrement())
  email            String     @unique
  // Nullable: OAuth (AC-10) and magic-link-only (AC-12) users may never set a password.
  passwordHash     String?    @map("password_hash")
  username         String?
  displayName      String?    @map("display_name")
  avatarUrl        String?    @map("avatar_url")
  role             Role       @default(customer)
  gmailVerified    Boolean    @default(false) @map("gmail_verified")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  // AES-256-GCM ciphertext (see src/common/crypto/secret-cipher.ts), never the raw TOTP secret.
  twoFactorSecret  String?    @map("two_factor_secret")
  status           UserStatus @default(active)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  lastLoginAt      DateTime?  @map("last_login_at")

  // Last inbound WhatsApp message timestamp — drives the notifications spec's AC-6 24-48hr
  // fallback-to-email/in-app check (docs/specs/2026-08-28-02-notifications-system.md).
  lastWhatsappInboundAt DateTime? @map("last_whatsapp_inbound_at")
  // E.164 phone — no field existed anywhere in the schema before this; WhatsApp (AC-6) and SMS
  // (AC-10) delivery have nothing to send to without it. Nullable: most users won't set one, and
  // those channels simply have nothing to dispatch to until they do (same "not configured" path
  // as an unset Twilio credential).
  phone String? @map("phone")

  sessions             Session[]
  adminPermissions     AdminPermission[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  notificationPreferences NotificationPreference[]
  favorites            Favorite[]
  authorizedFiles      CustomerAuthorizedFile[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Long-lived random id read from the czd_device_id cookie — the device-trust mechanism
  // chosen for AC-2/AC-3 (spec §8 risk #2 left this open; not part of the original DDL).
  deviceId   String  @map("device_id")
  deviceInfo Json?   @map("device_info")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  isVerified Boolean @default(false) @map("is_verified")
  // Hash of the 4-digit code (never the plaintext), shared by new-device verification (AC-3/AC-4)
  // and reused per-purpose for forgot-password (AC-6) via VerificationCodeService.
  verificationCodeHash  String?   @map("verification_code_hash")
  verificationAttempts  Int       @default(0) @map("verification_attempts")
  verificationExpiresAt DateTime? @map("verification_expires_at")

  createdAt      DateTime  @default(now()) @map("created_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([userId, deviceId], map: "idx_sessions_device_user")
  @@map("sessions")
}

model AdminPermission {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  module      AdminModule
  accessLevel AdminAccessLevel @map("access_level")
  revokedAt   DateTime?        @map("revoked_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId], map: "idx_admin_permissions_user_id")
  @@map("admin_permissions")
}

model AuditLog {
  id           BigInt  @id @default(autoincrement())
  adminUserId  BigInt? @map("admin_user_id")
  adminUser    User?   @relation(fields: [adminUserId], references: [id])

  actionType   String  @map("action_type")
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  changes      Json?
  ipAddress    String? @map("ip_address")
  userAgent    String? @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminUserId], map: "idx_audit_logs_admin_user_id")
  @@map("audit_logs")
}

// docs/specs/2026-08-28-03-admin-platform-settings.md §4 (aspect A-005/A-005a/A-005b/A-005c).
// True singleton: always id=1, enforced by PlatformSettingsService, not a DB constraint — the
// simplest correct shape for "one row of global config". Seeded by the AddPlatformSettings
// migration so the public site never renders with null contact info (spec §4 backfill note).
model PlatformSettings {
  id                  Int      @id @default(1)
  whatsappNumber      String?  @map("whatsapp_number")
  contactEmail        String?  @map("contact_email")
  domain              String?
  facebookUrl         String?  @map("facebook_url")
  instagramUrl        String?  @map("instagram_url")
  linkedinUrl         String?  @map("linkedin_url")
  xTwitterUrl         String?  @map("x_twitter_url")
  youtubeUrl          String?  @map("youtube_url")
  experienceStartYear Int      @map("experience_start_year")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedByAdminId    BigInt?  @map("updated_by_admin_id")

  @@map("platform_settings")
}

enum PaymentMethodType {
  paypal
  bank_transfer
  credit_card
}

// AC-2/AC-10 — non-secret display config only (e.g. bank name/account-title for customer
// display, enabled currencies). Secrets (PayPal client secret, bank account number) live in the
// secrets manager per spec §8 risk #2, never in this table — storage mechanism still Open.
model PaymentMethodSetting {
  id        BigInt            @id @default(autoincrement())
  method    PaymentMethodType @unique
  isEnabled Boolean           @default(false) @map("is_enabled")
  config    Json?
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("payment_method_settings")
}

// docs/specs/2026-08-28-02-notifications-system.md §4 (aspect A-004). Consolidated across every
// spec that names a trigger — extend here, never per-feature (spec §8 risk #2):
// auth-account-security (new_device_login), orders-payment-processing (order_confirmed,
// payment_received, files_ready, receipt_uploaded, order_status_change), smart-get-a-quote
// (quote_submitted, quote_response), custom-design-requests (custom_request_status_update),
// taebo-chatbot (taebo_waiting, taebo_answered), subscriptions-credits (subscription_renewal,
// subscription_renewal_failed, credit_purchase), auth registration (new_registration), platform
// (contact_message, admin_alert, system_alert, file_format_available).
enum NotificationType {
  order_confirmed
  payment_received
  files_ready
  quote_submitted
  quote_response
  custom_request_status_update
  file_format_available
  subscription_renewal
  subscription_renewal_failed
  credit_purchase
  new_registration
  new_device_login
  taebo_waiting
  taebo_answered
  contact_message
  receipt_uploaded
  admin_alert
  system_alert
  order_status_change
}

enum NotificationChannel {
  email
  whatsapp
  in_app
  push
  sms
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
  retried
}

model Notification {
  id                BigInt            @id @default(autoincrement())
  recipientUserId   BigInt            @map("recipient_user_id")
  recipient         User              @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  notificationType  NotificationType  @map("notification_type")
  title             String
  message           String?

  // Plain nullable BigInt, no @relation — Order/Quote/CustomRequest models don't exist yet
  // (A-013/A-016/A-017 are still Blocked per docs/specs/SPEC_INDEX.md). Each of those aspects
  // wires the real @relation + FK constraint in its own migration once its table exists.
  relatedOrderId         BigInt? @map("related_order_id")
  relatedQuoteId         BigInt? @map("related_quote_id")
  relatedCustomRequestId BigInt? @map("related_custom_request_id")

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  // 30-day retention for customer-facing types (AC-3), set at insert time; null for Admin-only
  // types (AC-2 states no equivalent cap for those). The cleanup sweep is a plain range query.
  expiresAt DateTime? @map("expires_at")

  // Set once an order_status_change row has been included in the daily digest email
  // (NotificationBatchingService, §8) — lets that job select "since the last digest" without a
  // separate scheduler-state table. Unused by every other notification_type.
  batchedAt DateTime? @map("batched_at")

  deliveryLogs NotificationDeliveryLog[]

  @@index([recipientUserId, isRead], map: "idx_notifications_user")
  @@index([expiresAt], map: "idx_notifications_expires_at")
  @@map("notifications")
}

// docs/specs/2026-08-28-02-notifications-system.md §4 — supports AC-5's retry/backoff and
// debugging delivery failures.
model NotificationDeliveryLog {
  id                BigInt                     @id @default(autoincrement())
  notificationId    BigInt                     @map("notification_id")
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(queued)
  providerMessageId String?                    @map("provider_message_id")
  attemptedAt       DateTime                   @default(now()) @map("attempted_at")

  @@index([notificationId], map: "idx_notification_delivery_log_notification")
  @@map("notification_delivery_log")
}

// AC-9: per-type/per-channel customer opt-out layered on top of the platform-wide default
// routing table (NotificationService.DEFAULT_CHANNELS). Absence of a row = default-enabled;
// a row only exists to record an explicit opt-out or a re-opt-in after one.
model NotificationPreference {
  id               BigInt              @id @default(autoincrement())
  userId           BigInt              @map("user_id")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationType NotificationType    @map("notification_type")
  channel          NotificationChannel
  enabled          Boolean             @default(true)
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([userId, notificationType, channel], map: "uq_notification_preferences_user_type_channel")
  @@map("notification_preferences")
}

// docs/specs/2026-08-28-04-design-catalog-browsing.md §4 (aspect A-006). Two-level category tree
// per architecture's own DDL (`designs.subcategory_id REFERENCES design_subcategories(id)` — a
// distinct table, not a self-referencing one).
model DesignCategory {
  id          BigInt   @id @default(autoincrement())
  name        String
  slug        String   @unique
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subcategories DesignSubcategory[]
  assignments   DesignCategoryAssignment[]
  dynamicBundleRules DynamicBundleRule[]

  @@map("design_categories")
}

model DesignSubcategory {
  id               BigInt   @id @default(autoincrement())
  name             String
  slug             String   @unique
  parentCategoryId BigInt   @map("parent_category_id")
  parentCategory   DesignCategory @relation(fields: [parentCategoryId], references: [id], onDelete: Cascade)
  sortOrder        Int      @default(0) @map("sort_order")
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  designs Design[]

  @@index([parentCategoryId], map: "idx_design_subcategories_parent")
  @@map("design_subcategories")
}

// AC-2 — a design assigned to multiple categories via this join table (spec §4: supersedes the
// architecture DDL's single `designs.category_id` FK). Subcategory stays a single optional FK
// (architecture DDL, spec §8 risk #2) — only category membership is many-to-many.
model DesignCategoryAssignment {
  designId   BigInt @map("design_id")
  design     Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  categoryId BigInt @map("category_id")
  category   DesignCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([designId, categoryId])
  @@map("design_category_assignments")
}

model Design {
  id               BigInt   @id @default(autoincrement())
  name             String
  description      String?
  previewImageUrl  String   @map("preview_image_url")
  galleryImageUrls String[] @map("gallery_image_urls")

  subcategoryId BigInt?            @map("subcategory_id")
  subcategory   DesignSubcategory? @relation(fields: [subcategoryId], references: [id])

  // AC-5 — dual-media (Vector vs. Embroidery) auto-swap. All nullable: a design may have only
  // one media type uploaded, in which case autoSwapEnabled has nothing to swap between.
  vectorImageUrl     String?  @map("vector_image_url")
  vectorVideoUrl     String?  @map("vector_video_url")
  embroideryImageUrl String?  @map("embroidery_image_url")
  embroideryVideoUrl String?  @map("embroidery_video_url")
  autoSwapEnabled    Boolean  @default(false) @map("auto_swap_enabled")

  tags String[] @default([])

  pricePkr      Decimal  @map("price_pkr") @db.Decimal(10, 2)
  salePricePkr  Decimal? @map("sale_price_pkr") @db.Decimal(10, 2)
  discountBadge String?  @map("discount_badge")

  stitchCount        Int? @map("stitch_count")
  threadColorCount    Int? @map("thread_color_count")
  threadColorChanges  Int? @map("thread_color_changes")

  isPublished      Boolean   @default(false) @map("is_published")
  createdByAdminId BigInt?   @map("created_by_admin_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sizes              DesignSize[]
  categoryAssignments DesignCategoryAssignment[]
  favorites          Favorite[]
  files              DesignFile[]
  bundleMemberships  BundleDesign[]

  @@index([subcategoryId], map: "idx_designs_subcategory")
  @@index([isPublished], map: "idx_designs_published")
  @@map("designs")
}

model DesignSize {
  id           BigInt   @id @default(autoincrement())
  designId     BigInt   @map("design_id")
  design       Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  sizeLabel    String   @map("size_label")
  sizeWidthMm  Decimal  @map("size_width_mm") @db.Decimal(8, 2)
  sizeHeightMm Decimal  @map("size_height_mm") @db.Decimal(8, 2)
  sizeOrder    Int      @default(0) @map("size_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([designId], map: "idx_design_sizes_design")
  @@map("design_sizes")
}

// AC-8 — persists per-customer across sessions.
model Favorite {
  id         BigInt   @id @default(autoincrement())
  customerId BigInt   @map("customer_id")
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  designId   BigInt   @map("design_id")
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, designId], map: "uq_favorites_customer_design")
  @@map("favorites")
}

// docs/specs/2026-08-28-05-private-file-management.md §4 (aspect A-007). AC-13/AC-14 — Admin-
// managed allowed-format registry so a new machine-format extension can be added without a code
// deploy. `EMB` is seeded is_private=true/is_locked=true by the AddPrivateFileManagement migration.
// The service layer refuses any write that would flip either flag on a locked row, backstopped by
// the locked_format_stays_private CHECK constraint (migration 20260903040500) — same posture as
// design_files' emb_never_public (AC-2), so a direct DB write bypassing the service is rejected too.
model AllowedFileFormat {
  id            BigInt   @id @default(autoincrement())
  extension     String   @unique
  displayName   String   @map("display_name")
  isPrivate     Boolean  @default(false) @map("is_private")
  isLocked      Boolean  @default(false) @map("is_locked")
  isActive      Boolean  @default(true) @map("is_active")
  maxFileSizeMb Int      @default(50) @map("max_file_size_mb")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("allowed_file_formats")
}

// AC-1/AC-2/AC-7/AC-12 — design_files per architecture §Database Schema, plus content_validated
// (magic-byte check) and version history (versionNumber/supersededByFileId) from this spec's §4.
// file_format is a validated String (checked against AllowedFileFormat.extension in the service
// layer, AC-13) rather than the architecture DDL's fixed Postgres ENUM — spec §8 risk #4 notes
// full DB-level open-endedness is a follow-up, not achieved here.
model DesignFile {
  id       BigInt @id @default(autoincrement())
  designId BigInt @map("design_id")
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  fileFormat String @map("file_format")
  // Never exposed in any DTO — AC-4/AC-8's "real storage path is never present in the response".
  storagePath      String  @map("storage_path")
  fileSizeBytes    BigInt  @map("file_size_bytes")
  uploadHash       String  @map("upload_hash") // AC-7 — dedup key (sha256 of file content)
  isPrivate        Boolean @default(true) @map("is_private")
  contentValidated Boolean @default(false) @map("content_validated")

  // AC-12 — replacing a file creates a new row pointing supersededByFileId at the old one,
  // instead of overwriting it, so Admin can view/restore a previous version.
  versionNumber      Int         @default(1) @map("version_number")
  supersededByFileId BigInt?     @unique @map("superseded_by_file_id")
  supersededBy       DesignFile? @relation("FileVersionHistory", fields: [supersededByFileId], references: [id])
  previousVersion     DesignFile? @relation("FileVersionHistory")

  createdByAdminId BigInt?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")

  authorizedFiles CustomerAuthorizedFile[]

  @@index([designId], map: "idx_design_files_design")
  @@index([uploadHash], map: "idx_design_files_upload_hash")
  @@map("design_files")
  // emb_never_public CHECK constraint added via raw SQL in this model's migration — see
  // AddPrivateFileManagement/migration.sql. Prisma's schema DSL has no @@check clause in this
  // Prisma version (5.x), so the constraint is hand-appended to the generated migration, the same
  // way every other DB-level invariant not expressible in the schema DSL is added in this repo.
}

// AC-4/5/6/8/9/11 — customer-authorized download records. orderId is a plain BigInt with NO FK
// yet: `orders` (A-013 Orders & Payment Processing) doesn't exist, and per SPEC_INDEX.md, A-013
// depends on THIS aspect, not the reverse — a real circularity in the spec's own data model
// section. TODO(A-013): add `order Order @relation(...)` once that table exists. customerId is
// included (with a real FK, since User exists today) so the authorization check has something
// concrete to key on even before orderId is enforced at the DB level.
model CustomerAuthorizedFile {
  id BigInt @id @default(autoincrement())

  orderId    BigInt @map("order_id") // TODO(A-013): no FK yet — orders table doesn't exist
  customerId BigInt @map("customer_id")
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  designFileId BigInt     @map("design_file_id")
  designFile   DesignFile @relation(fields: [designFileId], references: [id], onDelete: Cascade)

  downloadCount      Int       @default(0) @map("download_count")
  firstDownloadAt    DateTime? @map("first_download_at")
  lastDownloadAt     DateTime? @map("last_download_at")
  // AC-11 — Admin-set per-record download-attempt cap; null means no cap.
  maxDownloadAttempts Int?     @map("max_download_attempts")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "idx_customer_authorized_files_order")
  @@index([customerId], map: "idx_customer_authorized_files_customer")
  @@map("customer_authorized_files")
}

// docs/specs/2026-08-28-06-design-bundles.md §4 (aspect A-008). Never hard-deleted — AC-5 requires
// existing purchasers keep order history/file access after Admin unpublishes or deletes a bundle,
// so deletedAt is a soft-delete flag rather than a row removal, same posture as Design.
model DesignBundle {
  id               BigInt   @id @default(autoincrement())
  name             String
  description      String?
  previewImageUrl  String?  @map("preview_image_url")
  pricePkr         Decimal  @map("price_pkr") @db.Decimal(10, 2)
  salePricePkr     Decimal? @map("sale_price_pkr") @db.Decimal(10, 2)
  isPublished      Boolean  @default(false) @map("is_published")
  createdByAdminId BigInt?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  designs BundleDesign[]

  @@index([isPublished], map: "idx_design_bundles_published")
  @@map("design_bundles")
}

// AC-1/AC-7 — bundle membership join table. priceOverridePkr (AC-7) lets Admin override a specific
// design's contribution to the bundle total instead of using Design.pricePkr; null means "use the
// design's own price". sortOrder controls display order on the bundle detail page.
model BundleDesign {
  id       BigInt       @id @default(autoincrement())
  bundleId BigInt       @map("bundle_id")
  bundle   DesignBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  designId BigInt       @map("design_id")
  design   Design       @relation(fields: [designId], references: [id], onDelete: Cascade)

  sortOrder        Int?     @map("sort_order")
  priceOverridePkr Decimal? @map("price_override_pkr") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bundleId, designId], map: "uq_bundle_designs_bundle_design")
  @@index([designId], map: "idx_bundle_designs_design")
  @@map("bundle_designs")
}

// AC-6 — "any N designs from Category X for Y PKR" dynamic bundle rules. Modeled and
// admin-manageable now; automatic application at checkout is a cart feature (TODO(A-011) —
// Shopping Cart & Checkout, still Blocked per SPEC_INDEX.md) and is not implemented here.
model DynamicBundleRule {
  id                  BigInt         @id @default(autoincrement())
  name                String
  categoryId          BigInt         @map("category_id")
  category            DesignCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requiredDesignCount Int            @map("required_design_count")
  bundlePricePkr      Decimal        @map("bundle_price_pkr") @db.Decimal(10, 2)
  isPublished         Boolean        @default(false) @map("is_published")
  createdByAdminId    BigInt?        @map("created_by_admin_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([categoryId], map: "idx_dynamic_bundle_rules_category")
  @@map("dynamic_bundle_rules")
}
