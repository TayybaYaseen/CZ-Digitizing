// Schema for docs/specs/2026-08-28-01-auth-account-security.md (aspect A-002).
// Modeled on CZ_DIGITIZING_ARCHITECTURE.md § Database Schema (Users/Sessions/Audit Logs) plus
// the spec's proposed admin_permissions table. Deliberately scoped to only the tables this
// aspect owns — designs/orders/etc. belong to their own specs' migrations (docs/CLAUDE.md
// dependency-ordered build rule).

// Generated to a project-local path and imported by relative path (not the "@prisma/client"
// package name) everywhere in apps/api. In a pnpm workspace, "@prisma/client"'s own postinstall
// hook can't auto-locate a non-default-path schema (silently no-ops instead of erroring), and
// even once generation is wired up explicitly, Node's symlink-following module resolution can
// land the output and the package-name lookup in different places depending on what invoked
// `prisma generate` and from where — this sidesteps that whole class of bug outright.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
  freelancer
  moderator
}

enum UserStatus {
  active
  inactive
  suspended
}

// docs/specs/2026-08-28-01-auth-account-security.md §4 — derived default list (2026-08-31),
// covers the resource groups named across the other feature specs. Adding a module later is a
// non-breaking enum addition.
enum AdminModule {
  designs
  categories
  bundles
  orders
  quotes
  custom_requests
  faqs
  tips
  testimonials
  blog
  about
  portfolio
  subscriptions
  credits
  notifications
  settings
}

enum AdminAccessLevel {
  read_only
  crud
}

model User {
  id               BigInt     @id @default(autoincrement())
  email            String     @unique
  // Nullable: OAuth (AC-10) and magic-link-only (AC-12) users may never set a password.
  passwordHash     String?    @map("password_hash")
  username         String?
  displayName      String?    @map("display_name")
  avatarUrl        String?    @map("avatar_url")
  role             Role       @default(customer)
  gmailVerified    Boolean    @default(false) @map("gmail_verified")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  // AES-256-GCM ciphertext (see src/common/crypto/secret-cipher.ts), never the raw TOTP secret.
  twoFactorSecret  String?    @map("two_factor_secret")
  status           UserStatus @default(active)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  lastLoginAt      DateTime?  @map("last_login_at")

  // Last inbound WhatsApp message timestamp — drives the notifications spec's AC-6 24-48hr
  // fallback-to-email/in-app check (docs/specs/2026-08-28-02-notifications-system.md).
  lastWhatsappInboundAt DateTime? @map("last_whatsapp_inbound_at")
  // E.164 phone — no field existed anywhere in the schema before this; WhatsApp (AC-6) and SMS
  // (AC-10) delivery have nothing to send to without it. Nullable: most users won't set one, and
  // those channels simply have nothing to dispatch to until they do (same "not configured" path
  // as an unset Twilio credential).
  phone                 String?   @map("phone")

  sessions                Session[]
  adminPermissions        AdminPermission[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  favorites               Favorite[]
  authorizedFiles         CustomerAuthorizedFile[]
  cart                    Cart?
  // AC-7 — every past/future order accumulates against this one persistent identity.
  orders                  Order[]
  reviewedReceipts        PaymentReceipt[]         @relation("ReceiptReviewedByAdmin")
  subscription            CustomerSubscription?
  credits                 CustomerCredits?
  creditTransactions      CreditTransaction[]      @relation("CreditTransactionOwner")
  sentGifts               CreditTransaction[]      @relation("CreditTransactionGiftCounterparty")
  submittedTestimonials   Testimonial[]            @relation("TestimonialSubmittedBy")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Long-lived random id read from the czd_device_id cookie — the device-trust mechanism
  // chosen for AC-2/AC-3 (spec §8 risk #2 left this open; not part of the original DDL).
  deviceId   String  @map("device_id")
  deviceInfo Json?   @map("device_info")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  isVerified            Boolean   @default(false) @map("is_verified")
  // Hash of the 4-digit code (never the plaintext), shared by new-device verification (AC-3/AC-4)
  // and reused per-purpose for forgot-password (AC-6) via VerificationCodeService.
  verificationCodeHash  String?   @map("verification_code_hash")
  verificationAttempts  Int       @default(0) @map("verification_attempts")
  verificationExpiresAt DateTime? @map("verification_expires_at")

  createdAt      DateTime  @default(now()) @map("created_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([userId, deviceId], map: "idx_sessions_device_user")
  @@map("sessions")
}

model AdminPermission {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  module      AdminModule
  accessLevel AdminAccessLevel @map("access_level")
  revokedAt   DateTime?        @map("revoked_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId], map: "idx_admin_permissions_user_id")
  @@map("admin_permissions")
}

model AuditLog {
  id          BigInt  @id @default(autoincrement())
  adminUserId BigInt? @map("admin_user_id")
  adminUser   User?   @relation(fields: [adminUserId], references: [id])

  actionType   String   @map("action_type")
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  changes      Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminUserId], map: "idx_audit_logs_admin_user_id")
  @@map("audit_logs")
}

// docs/specs/2026-08-28-03-admin-platform-settings.md §4 (aspect A-005/A-005a/A-005b/A-005c).
// True singleton: always id=1, enforced by PlatformSettingsService, not a DB constraint — the
// simplest correct shape for "one row of global config". Seeded by the AddPlatformSettings
// migration so the public site never renders with null contact info (spec §4 backfill note).
model PlatformSettings {
  id                  Int      @id @default(1)
  whatsappNumber      String?  @map("whatsapp_number")
  contactEmail        String?  @map("contact_email")
  domain              String?
  facebookUrl         String?  @map("facebook_url")
  instagramUrl        String?  @map("instagram_url")
  linkedinUrl         String?  @map("linkedin_url")
  xTwitterUrl         String?  @map("x_twitter_url")
  youtubeUrl          String?  @map("youtube_url")
  experienceStartYear Int      @map("experience_start_year")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedByAdminId    BigInt?  @map("updated_by_admin_id")

  @@map("platform_settings")
}

enum PaymentMethodType {
  paypal
  bank_transfer
  credit_card
}

// docs/specs/2026-08-28-08-orders-payment-processing.md §4 (aspect A-013). Deliberately NOT reusing
// PaymentMethodType above: that enum is display-config keyed (payment_method_settings.method,
// includes 'credit_card' as a generic label) and is owned by A-005's settings module. This enum is
// the order's actual settlement rail and needs 'stripe' as its own value (Stripe ≠ "credit_card" —
// the settings toggle is what Admin shows on checkout; this is what actually processed the charge).
enum PaymentMethod {
  paypal
  stripe
  bank_transfer
}

// Authoritative state machine, spec §3. paymentStatus (below) is intentionally a *separate* field
// from status even though they mostly move in lockstep — see Order.paymentStatus doc comment for
// why one field alone can't carry both meanings.
enum OrderStatus {
  pending
  payment_pending
  payment_confirmed
  processing
  ready
  completed
  cancelled
  refunded
}

// AC-5's "Rejected/Pending" outcome needs a payment-status concept distinct from the order's
// fulfillment status — a rejected receipt returns paymentStatus to 'pending' while the order
// itself may still show 'payment_pending' (awaiting a fresh receipt) or move to 'cancelled'
// depending on Admin's action. Kept as its own enum (not reusing OrderStatus) because "refunded"
// here means "money was returned", which is orthogonal to OrderStatus.refunded meaning "the whole
// order's terminal state is refunded" — a partial refund sets paymentStatus while status stays
// completed/processing.
enum OrderPaymentStatus {
  pending
  completed
  refunded
  partially_refunded
  failed
}

// AC-12 — tags a renewal charge processed through this same payment layer. The renewal trigger
// itself belongs to A-015 (Subscriptions & Credits, still Blocked per SPEC_INDEX.md); this field
// only exists so that future caller can set it.
enum PaymentTransactionType {
  purchase
  renewal
}

enum ReceiptReviewStatus {
  pending
  confirmed
  rejected
}

// AC-2/AC-10 — non-secret display config only (e.g. bank name/account-title for customer
// display, enabled currencies). Secrets (PayPal client secret, bank account number) live in the
// secrets manager per spec §8 risk #2, never in this table — storage mechanism still Open.
model PaymentMethodSetting {
  id        BigInt            @id @default(autoincrement())
  method    PaymentMethodType @unique
  isEnabled Boolean           @default(false) @map("is_enabled")
  config    Json?
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("payment_method_settings")
}

// docs/specs/2026-08-28-02-notifications-system.md §4 (aspect A-004). Consolidated across every
// spec that names a trigger — extend here, never per-feature (spec §8 risk #2):
// auth-account-security (new_device_login), orders-payment-processing (order_confirmed,
// payment_received, files_ready, receipt_uploaded, order_status_change), smart-get-a-quote
// (quote_submitted, quote_response), custom-design-requests (custom_request_status_update),
// taebo-chatbot (taebo_waiting, taebo_answered), subscriptions-credits (subscription_renewal,
// subscription_renewal_failed, subscription_logo_limit_low, credit_purchase), auth registration
// (new_registration), platform
// (contact_message, admin_alert, system_alert, file_format_available).
enum NotificationType {
  order_confirmed
  payment_received
  files_ready
  quote_submitted
  quote_response
  custom_request_status_update
  file_format_available
  subscription_renewal
  subscription_renewal_failed
  subscription_logo_limit_low
  credit_purchase
  new_registration
  new_device_login
  taebo_waiting
  taebo_answered
  contact_message
  receipt_uploaded
  admin_alert
  system_alert
  order_status_change
}

enum NotificationChannel {
  email
  whatsapp
  in_app
  push
  sms
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
  retried
}

model Notification {
  id              BigInt @id @default(autoincrement())
  recipientUserId BigInt @map("recipient_user_id")
  recipient       User   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  notificationType NotificationType @map("notification_type")
  title            String
  message          String?

  // relatedQuoteId/relatedCustomRequestId stay plain BigInt, no @relation — Quote/CustomRequest
  // models don't exist yet (A-016/A-017 still Blocked per docs/specs/SPEC_INDEX.md). Those aspects
  // wire the real @relation + FK constraint in their own migration once their table exists.
  // relatedOrderId now has a real FK: wired by A-013 (Orders & Payment Processing) once Order
  // exists, per this field's own former TODO(A-013) comment.
  relatedOrderId         BigInt? @map("related_order_id")
  order                  Order?  @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedQuoteId         BigInt? @map("related_quote_id")
  relatedCustomRequestId BigInt? @map("related_custom_request_id")

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  // 30-day retention for customer-facing types (AC-3), set at insert time; null for Admin-only
  // types (AC-2 states no equivalent cap for those). The cleanup sweep is a plain range query.
  expiresAt DateTime? @map("expires_at")

  // Set once an order_status_change row has been included in the daily digest email
  // (NotificationBatchingService, §8) — lets that job select "since the last digest" without a
  // separate scheduler-state table. Unused by every other notification_type.
  batchedAt DateTime? @map("batched_at")

  deliveryLogs NotificationDeliveryLog[]

  @@index([recipientUserId, isRead], map: "idx_notifications_user")
  @@index([expiresAt], map: "idx_notifications_expires_at")
  @@index([relatedOrderId], map: "idx_notifications_related_order")
  @@map("notifications")
}

// docs/specs/2026-08-28-02-notifications-system.md §4 — supports AC-5's retry/backoff and
// debugging delivery failures.
model NotificationDeliveryLog {
  id             BigInt       @id @default(autoincrement())
  notificationId BigInt       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(queued)
  providerMessageId String?                    @map("provider_message_id")
  attemptedAt       DateTime                   @default(now()) @map("attempted_at")

  @@index([notificationId], map: "idx_notification_delivery_log_notification")
  @@map("notification_delivery_log")
}

// AC-9: per-type/per-channel customer opt-out layered on top of the platform-wide default
// routing table (NotificationService.DEFAULT_CHANNELS). Absence of a row = default-enabled;
// a row only exists to record an explicit opt-out or a re-opt-in after one.
model NotificationPreference {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationType NotificationType    @map("notification_type")
  channel          NotificationChannel
  enabled          Boolean             @default(true)
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([userId, notificationType, channel], map: "uq_notification_preferences_user_type_channel")
  @@map("notification_preferences")
}

// docs/specs/2026-08-28-04-design-catalog-browsing.md §4 (aspect A-006). Two-level category tree
// per architecture's own DDL (`designs.subcategory_id REFERENCES design_subcategories(id)` — a
// distinct table, not a self-referencing one).
model DesignCategory {
  id          BigInt   @id @default(autoincrement())
  name        String
  slug        String   @unique
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subcategories      DesignSubcategory[]
  assignments        DesignCategoryAssignment[]
  dynamicBundleRules DynamicBundleRule[]

  @@map("design_categories")
}

model DesignSubcategory {
  id               BigInt         @id @default(autoincrement())
  name             String
  slug             String         @unique
  parentCategoryId BigInt         @map("parent_category_id")
  parentCategory   DesignCategory @relation(fields: [parentCategoryId], references: [id], onDelete: Cascade)
  sortOrder        Int            @default(0) @map("sort_order")
  isPublished      Boolean        @default(false) @map("is_published")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  designs Design[]

  @@index([parentCategoryId], map: "idx_design_subcategories_parent")
  @@map("design_subcategories")
}

// AC-2 — a design assigned to multiple categories via this join table (spec §4: supersedes the
// architecture DDL's single `designs.category_id` FK). Subcategory stays a single optional FK
// (architecture DDL, spec §8 risk #2) — only category membership is many-to-many.
model DesignCategoryAssignment {
  designId   BigInt         @map("design_id")
  design     Design         @relation(fields: [designId], references: [id], onDelete: Cascade)
  categoryId BigInt         @map("category_id")
  category   DesignCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([designId, categoryId])
  @@map("design_category_assignments")
}

model Design {
  id               BigInt   @id @default(autoincrement())
  name             String
  description      String?
  previewImageUrl  String   @map("preview_image_url")
  galleryImageUrls String[] @map("gallery_image_urls")

  subcategoryId BigInt?            @map("subcategory_id")
  subcategory   DesignSubcategory? @relation(fields: [subcategoryId], references: [id])

  // AC-5 — dual-media (Vector vs. Embroidery) auto-swap. All nullable: a design may have only
  // one media type uploaded, in which case autoSwapEnabled has nothing to swap between.
  vectorImageUrl     String? @map("vector_image_url")
  vectorVideoUrl     String? @map("vector_video_url")
  embroideryImageUrl String? @map("embroidery_image_url")
  embroideryVideoUrl String? @map("embroidery_video_url")
  autoSwapEnabled    Boolean @default(false) @map("auto_swap_enabled")

  tags String[] @default([])

  pricePkr      Decimal  @map("price_pkr") @db.Decimal(10, 2)
  salePricePkr  Decimal? @map("sale_price_pkr") @db.Decimal(10, 2)
  discountBadge String?  @map("discount_badge")

  stitchCount        Int? @map("stitch_count")
  threadColorCount   Int? @map("thread_color_count")
  threadColorChanges Int? @map("thread_color_changes")

  isPublished      Boolean   @default(false) @map("is_published")
  createdByAdminId BigInt?   @map("created_by_admin_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sizes               DesignSize[]
  categoryAssignments DesignCategoryAssignment[]
  favorites           Favorite[]
  files               DesignFile[]
  bundleMemberships   BundleDesign[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@index([subcategoryId], map: "idx_designs_subcategory")
  @@index([isPublished], map: "idx_designs_published")
  @@map("designs")
}

model DesignSize {
  id           BigInt   @id @default(autoincrement())
  designId     BigInt   @map("design_id")
  design       Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  sizeLabel    String   @map("size_label")
  sizeWidthMm  Decimal  @map("size_width_mm") @db.Decimal(8, 2)
  sizeHeightMm Decimal  @map("size_height_mm") @db.Decimal(8, 2)
  sizeOrder    Int      @default(0) @map("size_order")
  createdAt    DateTime @default(now()) @map("created_at")

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([designId], map: "idx_design_sizes_design")
  @@map("design_sizes")
}

// AC-8 — persists per-customer across sessions.
model Favorite {
  id         BigInt   @id @default(autoincrement())
  customerId BigInt   @map("customer_id")
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  designId   BigInt   @map("design_id")
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, designId], map: "uq_favorites_customer_design")
  @@map("favorites")
}

// docs/specs/2026-08-28-05-private-file-management.md §4 (aspect A-007). AC-13/AC-14 — Admin-
// managed allowed-format registry so a new machine-format extension can be added without a code
// deploy. `EMB` is seeded is_private=true/is_locked=true by the AddPrivateFileManagement migration.
// The service layer refuses any write that would flip either flag on a locked row, backstopped by
// the locked_format_stays_private CHECK constraint (migration 20260903040500) — same posture as
// design_files' emb_never_public (AC-2), so a direct DB write bypassing the service is rejected too.
model AllowedFileFormat {
  id            BigInt   @id @default(autoincrement())
  extension     String   @unique
  displayName   String   @map("display_name")
  isPrivate     Boolean  @default(false) @map("is_private")
  isLocked      Boolean  @default(false) @map("is_locked")
  isActive      Boolean  @default(true) @map("is_active")
  maxFileSizeMb Int      @default(50) @map("max_file_size_mb")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("allowed_file_formats")
}

// AC-1/AC-2/AC-7/AC-12 — design_files per architecture §Database Schema, plus content_validated
// (magic-byte check) and version history (versionNumber/supersededByFileId) from this spec's §4.
// file_format is a validated String (checked against AllowedFileFormat.extension in the service
// layer, AC-13) rather than the architecture DDL's fixed Postgres ENUM — spec §8 risk #4 notes
// full DB-level open-endedness is a follow-up, not achieved here.
model DesignFile {
  id       BigInt @id @default(autoincrement())
  designId BigInt @map("design_id")
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  fileFormat       String  @map("file_format")
  // Never exposed in any DTO — AC-4/AC-8's "real storage path is never present in the response".
  storagePath      String  @map("storage_path")
  fileSizeBytes    BigInt  @map("file_size_bytes")
  uploadHash       String  @map("upload_hash") // AC-7 — dedup key (sha256 of file content)
  isPrivate        Boolean @default(true) @map("is_private")
  contentValidated Boolean @default(false) @map("content_validated")

  // AC-12 — replacing a file creates a new row pointing supersededByFileId at the old one,
  // instead of overwriting it, so Admin can view/restore a previous version.
  versionNumber      Int         @default(1) @map("version_number")
  supersededByFileId BigInt?     @unique @map("superseded_by_file_id")
  supersededBy       DesignFile? @relation("FileVersionHistory", fields: [supersededByFileId], references: [id])
  previousVersion    DesignFile? @relation("FileVersionHistory")

  createdByAdminId BigInt?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")

  authorizedFiles CustomerAuthorizedFile[]
  // emb_never_public CHECK constraint added via raw SQL in this model's migration — see
  // AddPrivateFileManagement/migration.sql. Prisma's schema DSL has no @@check clause in this
  // Prisma version (5.x), so the constraint is hand-appended to the generated migration, the same
  // way every other DB-level invariant not expressible in the schema DSL is added in this repo.

  @@index([designId], map: "idx_design_files_design")
  @@index([uploadHash], map: "idx_design_files_upload_hash")
  @@map("design_files")
}

// AC-4/5/6/8/9/11 — customer-authorized download records. orderId now carries a real FK
// (docs/specs/2026-08-28-08-orders-payment-processing.md, aspect A-013) — the circularity noted
// below is resolved: Order rows are created first (CartService.checkout -> OrdersService), and
// CustomerAuthorizedFile rows are only ever created afterward, at payment_confirmed time.
model CustomerAuthorizedFile {
  id BigInt @id @default(autoincrement())

  orderId    BigInt @map("order_id")
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId BigInt @map("customer_id")
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  designFileId BigInt     @map("design_file_id")
  designFile   DesignFile @relation(fields: [designFileId], references: [id], onDelete: Cascade)

  downloadCount       Int       @default(0) @map("download_count")
  firstDownloadAt     DateTime? @map("first_download_at")
  lastDownloadAt      DateTime? @map("last_download_at")
  // AC-11 — Admin-set per-record download-attempt cap; null means no cap.
  maxDownloadAttempts Int?      @map("max_download_attempts")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "idx_customer_authorized_files_order")
  @@index([customerId], map: "idx_customer_authorized_files_customer")
  @@map("customer_authorized_files")
}

// docs/specs/2026-08-28-06-design-bundles.md §4 (aspect A-008). Never hard-deleted — AC-5 requires
// existing purchasers keep order history/file access after Admin unpublishes or deletes a bundle,
// so deletedAt is a soft-delete flag rather than a row removal, same posture as Design.
model DesignBundle {
  id               BigInt    @id @default(autoincrement())
  name             String
  description      String?
  previewImageUrl  String?   @map("preview_image_url")
  pricePkr         Decimal   @map("price_pkr") @db.Decimal(10, 2)
  salePricePkr     Decimal?  @map("sale_price_pkr") @db.Decimal(10, 2)
  isPublished      Boolean   @default(false) @map("is_published")
  createdByAdminId BigInt?   @map("created_by_admin_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  designs    BundleDesign[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([isPublished], map: "idx_design_bundles_published")
  @@map("design_bundles")
}

// AC-1/AC-7 — bundle membership join table. priceOverridePkr (AC-7) lets Admin override a specific
// design's contribution to the bundle total instead of using Design.pricePkr; null means "use the
// design's own price". sortOrder controls display order on the bundle detail page.
model BundleDesign {
  id       BigInt       @id @default(autoincrement())
  bundleId BigInt       @map("bundle_id")
  bundle   DesignBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  designId BigInt       @map("design_id")
  design   Design       @relation(fields: [designId], references: [id], onDelete: Cascade)

  sortOrder        Int?     @map("sort_order")
  priceOverridePkr Decimal? @map("price_override_pkr") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bundleId, designId], map: "uq_bundle_designs_bundle_design")
  @@index([designId], map: "idx_bundle_designs_design")
  @@map("bundle_designs")
}

// AC-6 — "any N designs from Category X for Y PKR" dynamic bundle rules. Modeled and
// admin-manageable now; automatic application at checkout is a cart feature (TODO(A-011) —
// Shopping Cart & Checkout, still Blocked per SPEC_INDEX.md) and is not implemented here.
model DynamicBundleRule {
  id                  BigInt         @id @default(autoincrement())
  name                String
  categoryId          BigInt         @map("category_id")
  category            DesignCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requiredDesignCount Int            @map("required_design_count")
  bundlePricePkr      Decimal        @map("bundle_price_pkr") @db.Decimal(10, 2)
  isPublished         Boolean        @default(false) @map("is_published")
  createdByAdminId    BigInt?        @map("created_by_admin_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([categoryId], map: "idx_dynamic_bundle_rules_category")
  @@map("dynamic_bundle_rules")
}

// docs/specs/2026-08-28-07-shopping-cart-checkout.md §4 (aspect A-011). One cart per customer
// and, separately, one per guest-session cookie (czd_cart_session, minted by
// CartSessionMiddleware) — never both at once for the same physical visitor; AC-5's merge-on-login
// folds a guest cart's items into the customer's cart via CartService.mergeGuestCartInto() rather
// than repointing customerId onto the guest row, so a guest cart is always deletable afterward
// without touching the customer's own cart id.
model Cart {
  id             BigInt   @id @default(autoincrement())
  customerId     BigInt?  @unique @map("customer_id")
  customer       User?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestSessionId String?  @unique @map("guest_session_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

enum CartItemStatus {
  active
  saved_for_later
}

// AC-1/AC-2/AC-8 — designId/bundleId is exactly one of the two (CHECK constraint hand-appended to
// this model's migration, same posture as design_files' emb_never_public). sizeId is required for
// a design item (every Design has >=1 DesignSize per CreateDesignDto's own validation) and always
// null for a bundle item (bundles have no size concept). priceAtAddPkr is captured once at add
// time (feeds CartItemDto.linePriceAtSelectionPkr); the live unitPricePkr shown to the customer is
// always recomputed fresh from Design/BundlesService.computeBundleTotal() at read time, never
// trusted stale — this field exists purely so the UI can show "price changed since you added this".
model CartItem {
  id     BigInt @id @default(autoincrement())
  cartId BigInt @map("cart_id")
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  designId BigInt?       @map("design_id")
  design   Design?       @relation(fields: [designId], references: [id], onDelete: Cascade)
  bundleId BigInt?       @map("bundle_id")
  bundle   DesignBundle? @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  sizeId   BigInt?       @map("size_id")
  size     DesignSize?   @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  quantity      Int            @default(1)
  status        CartItemStatus @default(active)
  priceAtAddPkr Decimal        @map("price_at_add_pkr") @db.Decimal(10, 2)

  addedAt DateTime @default(now()) @map("added_at")

  @@index([cartId], map: "idx_cart_items_cart")
  @@map("cart_items")
}

// docs/specs/2026-08-28-08-orders-payment-processing.md §4 (aspect A-013). Created by
// OrdersService.createFromCart(), called from CartService.checkout() once cart validation passes
// (AC-6 of the Cart spec) — never created any other way, so every order always starts from a real,
// validated cart snapshot. AC-7: customerId is a required (non-nullable) FK — orders are a
// customer-purchasing concept only, same posture as Cart.customerId being the "real identity" side
// of that model's exactly-one-of-customer-or-guest split (there is no guest-order concept here).
model Order {
  id         BigInt @id @default(autoincrement())
  customerId BigInt @map("customer_id")
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status        OrderStatus        @default(pending)
  // Deliberately a field distinct from `status` (see OrderPaymentStatus's own doc comment above)
  // rather than folding payment state into the order-status enum — a partial refund, for example,
  // needs to be representable while the order's own fulfillment status stays `completed`.
  paymentStatus OrderPaymentStatus @default(pending) @map("payment_status")

  paymentMethod   PaymentMethod          @map("payment_method")
  transactionType PaymentTransactionType @default(purchase) @map("transaction_type")

  totalPkr     Decimal @map("total_pkr") @db.Decimal(10, 2)
  currencyCode String  @default("PKR") @map("currency_code")

  // AC-3 — unique per bank-transfer order, generated by OrdersService at creation time
  // (BankTransferReferenceGenerator). Null for paypal/stripe orders, which never need one.
  bankTransferReference String? @unique @map("bank_transfer_reference")

  // AC-1/AC-2 — set once PayPal's capture webhook is verified and processed.
  paypalOrderId   String? @map("paypal_order_id")
  paypalCaptureId String? @map("paypal_capture_id")

  // AC-10 — set once Stripe's payment_intent.succeeded webhook is verified and processed.
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // AC-11 — null until a refund is issued; full refund sets this to totalPkr and paymentStatus to
  // 'refunded', a partial refund sets a lesser amount and paymentStatus to 'partially_refunded'.
  refundedAmountPkr Decimal? @map("refunded_amount_pkr") @db.Decimal(10, 2)

  // docs/specs/2026-08-28-09-subscriptions-credits.md AC-7 — the amount of the customer's own
  // credit balance applied against this order's total at checkout. Null/0 for an order that used
  // no credits. Deliberately its own column rather than derived from CreditTransaction at read
  // time — mirrors totalPkr's own "snapshot, never re-derived" posture (OrderItem's doc comment
  // above), and OrdersService.refund()'s reverseCreditsUsedOnOrder() needs a stable amount to
  // reverse regardless of what the ledger looks like later.
  creditsUsed Decimal @default(0) @map("credits_used") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items              OrderItem[]
  receipts           PaymentReceipt[]
  authorizedFiles    CustomerAuthorizedFile[]
  notifications      Notification[]
  creditTransactions CreditTransaction[]
  testimonials       Testimonial[]

  @@index([customerId], map: "idx_orders_customer")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

// AC-1/AC-3 (Cart spec) mirrored at order time — a snapshot, never re-derived: unitPricePkr is
// copied from CartItem.priceAtAddPkr (or the live bundle/design total at checkout, whichever the
// service resolves) so a later price change never rewrites historical order records.
model OrderItem {
  id      BigInt @id @default(autoincrement())
  orderId BigInt @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  designId BigInt?       @map("design_id")
  design   Design?       @relation(fields: [designId], references: [id], onDelete: Restrict)
  bundleId BigInt?       @map("bundle_id")
  bundle   DesignBundle? @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  sizeId   BigInt?       @map("size_id")
  size     DesignSize?   @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  quantity     Int     @default(1)
  unitPricePkr Decimal @map("unit_price_pkr") @db.Decimal(10, 2)
  // CHECK: an order_item is a design line or a bundle line, never both/neither — same posture as
  // cart_items' cart_item_exactly_one_of_design_or_bundle. Hand-appended to this model's migration
  // (Prisma 5.x schema DSL has no @@check clause).

  @@index([orderId], map: "idx_order_items_order")
  @@map("order_items")
}

// AC-3/AC-4/AC-5 — bank-transfer receipt upload + Admin review. fileUrl is a StorageService
// storage path (private-disk posture, same as DesignFile.storagePath) — never a public URL, per
// spec §4 retention note (receipts may contain the sender's own bank details).
model PaymentReceipt {
  id      BigInt @id @default(autoincrement())
  orderId BigInt @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  reviewStatus      ReceiptReviewStatus @default(pending) @map("review_status")
  reviewedByAdminId BigInt?             @map("reviewed_by_admin_id")
  reviewedByAdmin   User?               @relation("ReceiptReviewedByAdmin", fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?           @map("reviewed_at")
  rejectionReason   String?             @map("rejection_reason")

  @@index([orderId], map: "idx_payment_receipts_order")
  @@map("payment_receipts")
}

// AC-8 — hourly-refreshed PKR conversion rates (ExchangeRateService cron, see
// cart-cleanup.service.ts for the @nestjs/schedule pattern this reuses). currencyCode is the
// non-PKR side of the pair; PKR itself is always the implicit "1.0" source of truth and never
// stored as its own row.
model ExchangeRate {
  currencyCode String   @id @map("currency_code")
  rateToPkr    Decimal  @map("rate_to_pkr") @db.Decimal(14, 6)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

// docs/specs/2026-08-28-09-subscriptions-credits.md §4 (aspect A-015).

enum BillingPeriod {
  monthly
  yearly
}

// AC-1 — Admin-authored plan; published plans surface on /pricing under the Subscription toggle.
// perks stored as a String[] (Postgres native array via Prisma) rather than a separate table —
// same posture as DesignBundle's flat scalar fields, no relational structure needed for a plain
// bullet list Admin edits as a whole.
model SubscriptionPlan {
  id             BigInt        @id @default(autoincrement())
  name           String
  billingPeriod  BillingPeriod @map("billing_period")
  pricePkr       Decimal       @map("price_pkr") @db.Decimal(10, 2)
  monthlyCredits Int           @map("monthly_credits")
  // Admin-set monthly logo/design-file download allowance granted by this plan, separate from and
  // in addition to monthlyCredits — null means unlimited (no cap enforced). Consumed via
  // SubscriptionsService.consumeLogoDownload(), reset to 0 alongside the credit grant on every
  // subscribe/renewal (same cycle boundary as monthlyCredits).
  logoLimit      Int?          @map("logo_limit")
  perks          String[]
  isBestValue    Boolean       @default(false) @map("is_best_value")
  isPublished    Boolean       @default(false) @map("is_published")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  subscriptions CustomerSubscription[]

  @@index([isPublished], map: "idx_subscription_plans_published")
  @@map("subscription_plans")
}

enum SubscriptionStatus {
  active
  cancelled
  lapsed
}

// AC-2/AC-3/AC-4/AC-9 — one active-or-historical subscription row per customer. A customer may
// only ever have one row at a time (unique customerId) — resubscribing after cancellation/lapse
// updates this same row rather than creating a second one, so "ALREADY_SUBSCRIBED" (spec §3) is a
// simple existence-plus-status check.
model CustomerSubscription {
  id         BigInt @id @default(autoincrement())
  customerId BigInt @unique @map("customer_id")
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  planId BigInt           @map("plan_id")
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status              SubscriptionStatus @default(active) @map("subscription_status")
  autoRenew           Boolean            @default(true) @map("auto_renew")
  startDate           DateTime           @map("start_date")
  // AC-3 — advances on every successful renewal charge; AC-4 — cancellation leaves this untouched
  // so paid-for access (endDate below) still runs out naturally.
  renewalDate         DateTime           @map("renewal_date")
  // AC-4 — set only on cancellation, to the already-paid renewalDate at the moment of cancelling;
  // null while active/auto-renewing (access simply keeps rolling forward via renewalDate instead).
  endDate             DateTime?          @map("end_date")
  failedRenewalCount  Int                @default(0) @map("failed_renewal_count")
  lastRenewalFailedAt DateTime?          @map("last_renewal_failed_at")

  // Logo/design-file downloads consumed against the plan's logoLimit this cycle. Reset to 0 (and
  // logoLimitWarnedAt to null) every time the monthly credit grant runs (subscribe/renewal) —
  // SubscriptionsService.grantMonthlyCredits() resets both in the same transaction.
  logosUsed         Int       @default(0) @map("logos_used")
  // Set the first time remaining-logos drops to <= LOW_LOGO_LIMIT_THRESHOLD within a cycle, so the
  // low-balance notification fires once per cycle rather than on every subsequent download.
  logoLimitWarnedAt DateTime? @map("logo_limit_warned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creditGrants SubscriptionCreditGrant[]

  @@index([status, renewalDate], map: "idx_customer_subscriptions_renewal")
  @@map("customer_subscriptions")
}

// spec §4 "proposed" table — links each monthly grant to its ledger entry so the renewal cron
// (AC-3) and the lapse check (AC-8) can tell "have we already granted this cycle's credits"
// without re-deriving it from CreditTransaction's free-text note field.
model SubscriptionCreditGrant {
  id                     BigInt               @id @default(autoincrement())
  customerSubscriptionId BigInt               @map("customer_subscription_id")
  subscription           CustomerSubscription @relation(fields: [customerSubscriptionId], references: [id], onDelete: Cascade)
  grantedAt              DateTime             @default(now()) @map("granted_at")
  creditTransactionId    BigInt               @unique @map("credit_transaction_id")
  creditTransaction      CreditTransaction    @relation(fields: [creditTransactionId], references: [id], onDelete: Restrict)

  @@index([customerSubscriptionId], map: "idx_subscription_credit_grants_subscription")
  @@map("subscription_credit_grants")
}

// AC-5 — Admin-authored credit pack (e.g. "25 credits + 5 bonus"); published packs surface on
// /pricing under the Buy Credits toggle.
model CreditPackage {
  id           BigInt   @id @default(autoincrement())
  name         String
  credits      Int
  bonusCredits Int      @default(0) @map("bonus_credits")
  pricePkr     Decimal  @map("price_pkr") @db.Decimal(10, 2)
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isPublished], map: "idx_credit_packages_published")
  @@map("credit_packages")
}

// AC-6/AC-7/AC-8/AC-10 — cached, derived balance (one row per customer). Always recomputed from
// CreditTransaction inside the same transaction that inserts a ledger row — never hand-edited
// independently of the ledger, so it can never drift from the append-only source of truth it
// mirrors. availableCredits must never go negative (spec §9 observability note) — enforced in
// CreditsService, not at the DB layer, since a CHECK constraint can't see the ledger.
model CustomerCredits {
  customerId       BigInt   @id @map("customer_id")
  customer         User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  totalCredits     Int      @default(0) @map("total_credits")
  availableCredits Int      @default(0) @map("available_credits")
  usedCredits      Int      @default(0) @map("used_credits")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("customer_credits")
}

enum CreditTransactionType {
  purchase
  usage
  refund
  adjustment
  grant
}

// AC-6/AC-7/AC-9/AC-10 — append-only ledger, never updated or deleted once written (spec §9
// rollout note: "credit ledger entries must never be deleted"). amount is signed: positive for
// purchase/refund/grant/gift-received, negative for usage/gift-sent, so a customer's balance is
// always re-derivable as sum(amount) even though CustomerCredits caches it for fast reads.
model CreditTransaction {
  id         BigInt                @id @default(autoincrement())
  customerId BigInt                @map("customer_id")
  customer   User                  @relation("CreditTransactionOwner", fields: [customerId], references: [id], onDelete: Cascade)
  type       CreditTransactionType
  amount     Int

  // AC-7 — usage-type rows reference the order the credits were applied to.
  relatedOrderId BigInt? @map("related_order_id")
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  // AC-10 — a gift's two adjustment rows (sender debit + recipient credit) reference each other's
  // owner via this counterparty pointer so either side of the gift can be traced from one row.
  giftCounterpartyId BigInt? @map("gift_counterparty_id")
  giftCounterparty   User?   @relation("CreditTransactionGiftCounterparty", fields: [giftCounterpartyId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  subscriptionGrant SubscriptionCreditGrant?

  @@index([customerId, createdAt], map: "idx_credit_transactions_customer")
  @@index([relatedOrderId], map: "idx_credit_transactions_order")
  @@map("credit_transactions")
}

// Internal payment-tracking only — never the acceptance-criteria-visible row itself. AC-2 says the
// customer_subscriptions row is created only once the first payment succeeds (unlike Order, which
// is created eagerly in payment_pending status); this table is what lets the PayPal/Stripe webhook
// handler, once it fires, recover which (customer, plan) pair a given paypalOrderId/
// stripePaymentIntentId was for, without the CustomerSubscription row needing to exist first.
// Deleted once processed (success or failure) — never accumulates.
model PendingSubscriptionPayment {
  id                    BigInt   @id @default(autoincrement())
  customerId            BigInt   @map("customer_id")
  planId                BigInt   @map("plan_id")
  paypalOrderId         String?  @unique @map("paypal_order_id")
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("pending_subscription_payments")
}

// Same role as PendingSubscriptionPayment, for AC-6's credit-package purchase.
model PendingCreditPurchase {
  id                    BigInt   @id @default(autoincrement())
  customerId            BigInt   @map("customer_id")
  packageId             BigInt   @map("package_id")
  paypalOrderId         String?  @unique @map("paypal_order_id")
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("pending_credit_purchases")
}

// Schema for docs/specs/2026-08-28-10-content-knowledge-base.md (aspect A-012, sub-aspects
// A-012a-f). A-021 (Internationalization) is still Not Started per SPEC_INDEX.md, so
// `languageCode` here is a plain stored column (default "en") with no real locale-resolution
// logic behind it yet — that mechanism is A-021's own job later.

// AC-1/AC-2/AC-8 — a complete website-wide knowledge base entry. `taeboVisible` gates whether
// Taebo (separate spec, still Blocked on this aspect) may surface this entry; helpfulness is kept
// as plain atomic counters (not a per-vote table) since AC-8 only requires an aggregated signal,
// not per-user vote idempotency.
model Faq {
  id               BigInt   @id @default(autoincrement())
  question         String
  answer           String
  topic            String
  relatedPage      String?  @map("related_page")
  relatedService   String?  @map("related_service")
  relatedCategory  String?  @map("related_category")
  languageCode     String   @default("en") @map("language_code")
  priority         Int      @default(0)
  taeboVisible     Boolean  @default(false) @map("taebo_visible")
  isPublished      Boolean  @default(false) @map("is_published")
  helpfulYesCount  Int      @default(0) @map("helpful_yes_count")
  helpfulNoCount   Int      @default(0) @map("helpful_no_count")
  createdByAdminId BigInt?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tipLinks TipFaqLink[]

  @@index([topic], map: "idx_faqs_topic")
  @@index([languageCode], map: "idx_faqs_language")
  @@index([taeboVisible], map: "idx_faqs_taebo_visible")
  @@map("faqs")
}

// AC-3 — embroidery-education articles, linkable to relevant FAQ entries via TipFaqLink.
model EmbroidererTip {
  id               BigInt   @id @default(autoincrement())
  title            String
  content          String
  category         String
  languageCode     String   @default("en") @map("language_code")
  isPublished      Boolean  @default(false) @map("is_published")
  createdByAdminId BigInt?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  faqLinks TipFaqLink[]

  @@index([category], map: "idx_tips_category")
  @@index([languageCode], map: "idx_tips_language")
  @@map("embroiderer_tips")
}

// SRS Addendum §8 — "Tips can be ... linked to FAQ". Not modeled in the architecture DDL.
model TipFaqLink {
  tipId BigInt         @map("tip_id")
  tip   EmbroidererTip @relation(fields: [tipId], references: [id], onDelete: Cascade)
  faqId BigInt         @map("faq_id")
  faq   Faq            @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@id([tipId, faqId])
  @@map("tip_faq_links")
}

// AC-4/AC-5/AC-7 — the one entity in the system where the data is intentionally public-facing
// customer PII (name/country/photo/feedback); Admin consent/removal is a process control (spec
// §4 Retention and privacy), not a system one. `source`/`moderationStatus` distinguish
// Admin-curated testimonials (always source=admin_curated, moderationStatus=approved on create)
// from customer-submitted reviews (AC-7: source=customer_submitted, moderationStatus=pending,
// isPublished=false until Admin approves) — orderId is required for the latter so a submission is
// always tied to a real completed purchase, never free-form.
model Testimonial {
  id               BigInt                @id @default(autoincrement())
  customerName     String                @map("customer_name")
  country          String
  business         String?
  photoUrl         String?               @map("photo_url")
  rating           Int
  feedback         String
  serviceUsed      String                @map("service_used")
  isPublished      Boolean               @default(false) @map("is_published")
  source           TestimonialSource     @default(admin_curated)
  moderationStatus TestimonialModeration @default(approved) @map("moderation_status")
  customerId       BigInt?               @map("customer_id")
  customer         User?                 @relation("TestimonialSubmittedBy", fields: [customerId], references: [id], onDelete: SetNull)
  orderId          BigInt?               @map("order_id")
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByAdminId BigInt?               @map("created_by_admin_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([isPublished, moderationStatus], map: "idx_testimonials_visibility")
  @@index([customerId], map: "idx_testimonials_customer")
  @@map("testimonials")
}

enum TestimonialSource {
  admin_curated
  customer_submitted
}

enum TestimonialModeration {
  approved
  pending
  rejected
}

// AC-9/AC-10/AC-15/AC-16 — hard delete (no deletedAt) per spec §4/AC-16: this architecture has no
// soft-delete precedent for this content type, so none is invented.
model BlogPost {
  id               BigInt    @id @default(autoincrement())
  title            String
  slug             String    @unique
  coverImageUrl    String?   @map("cover_image_url")
  body             String
  category         String
  languageCode     String    @default("en") @map("language_code")
  isPublished      Boolean   @default(false) @map("is_published")
  publishedAt      DateTime? @map("published_at")
  createdByAdminId BigInt?   @map("created_by_admin_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([isPublished, languageCode], map: "idx_blog_posts_visibility")
  @@index([category], map: "idx_blog_posts_category")
  @@map("blog_posts")
}

// AC-11 — single always-live static page per language, deliberately no isPublished (spec §4).
// Seeded with one placeholder "en" row by this model's migration so the public page never renders
// empty before Admin fills it in.
model AboutContent {
  languageCode     String   @id @map("language_code")
  heading          String
  body             String
  imageUrls        Json     @default("[]") @map("image_urls")
  updatedByAdminId BigInt?  @map("updated_by_admin_id")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("about_content")
}

// AC-12/AC-13/AC-17 — visual-first content, deliberately no languageCode (same treatment as
// Testimonial, spec §4): title/description render exactly as Admin entered them in every language.
model PortfolioItem {
  id               BigInt   @id @default(autoincrement())
  title            String
  description      String?
  mediaUrls        Json     @default("[]") @map("media_urls")
  category         String?
  sortOrder        Int      @default(0) @map("sort_order")
  isPublished      Boolean  @default(false) @map("is_published")
  createdByAdminId BigInt?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder], map: "idx_portfolio_items_visibility")
  @@map("portfolio_items")
}
