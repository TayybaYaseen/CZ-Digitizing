PORT=4000
NODE_ENV=development

# postgresql://<user>:<password>@<host>:<port>/<db> — matches root docker-compose.yml defaults
DATABASE_URL=postgresql://dev:dev@localhost:5432/czdigitizing

REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins — 8081/8083 are apps/mobile's `expo start --web`
# dev preview (its default port, and the fallback Expo picks when 8081 is busy); the native
# app itself (iOS/Android) makes no browser-origin fetches and needs no CORS entry.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:8081,http://localhost:8083
# Reverse-proxy hops to trust for the client IP (rate limits key on it). 0 locally; Render = 1.
TRUST_PROXY_HOPS=0

# --- Auth (docs/specs/2026-08-28-01-auth-account-security.md) ---

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
JWT_REFRESH_SECRET=dev-only-change-me-dev-only-change-me-dev-only

# AES-256-GCM key for encrypting users.two_factor_secret at rest — must decode to 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Email — optional. Unset = EmailService logs messages to the console instead of sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=CZ Digitizing <czdigitizing@gmail.com>
# Brevo Transactional Email API (Admin site staff emails) — server-side only, never NEXT_PUBLIC_*.
# Needs a Brevo REST key ("xkeysib-", Brevo → SMTP & API → API keys); an "xsmtpsib-" SMTP key is
# rejected by the REST API. Key + sender email must both be set to activate. Never commit real values.
BREVO_ADMIN_API_KEY=
BREVO_ADMIN_SENDER_EMAIL=
BREVO_ADMIN_SENDER_NAME=CZ Digitizing

# Brevo SMTP relay (customer emails) — server-side only, never NEXT_PUBLIC_*. Both required to
# activate; when set they take precedence over SMTP_*. The key is Brevo's "xsmtpsib-" SMTP key and
# the login is shown at Brevo → SMTP & API. The sender must be validated in Brevo. Never commit real values.
BREVO_CUSTOMER_API_KEY=
BREVO_CUSTOMER_SMTP_LOGIN=

# OAuth — optional per provider. A provider's routes return 501 until its client id/secret pair is set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Payments (docs/specs/2026-08-28-08-orders-payment-processing.md, A-013) — BANK TRANSFER ONLY.
# There are no payment-provider credentials to configure: customers transfer PKR to the bank account
# an Admin enters under Settings -> Bank transfer, then upload a receipt that an Admin approves.
#
# Local-currency DISPLAY only (GET /api/orders/:id?currencyCode=) — never used to price or charge a
# payment, which is always the exact PKR amount. Without EXCHANGE_RATE_API_KEY the display rates are
# the built-in approximate fallback table.
# EXCHANGE_RATE_API_KEY=

# Taebo LLM matching (docs/specs/2026-08-28-15-taebo-chatbot.md, AC-7) — optional. Unset = falls
# back to the local keyword matcher. Get a key at https://openrouter.ai/keys — never commit a real
# value here or anywhere else in the repo.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
