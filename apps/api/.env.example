PORT=4000
NODE_ENV=development

# postgresql://<user>:<password>@<host>:<port>/<db> — matches root docker-compose.yml defaults
DATABASE_URL=postgresql://dev:dev@localhost:5432/czdigitizing

REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins — 8081/8083 are apps/mobile's `expo start --web`
# dev preview (its default port, and the fallback Expo picks when 8081 is busy); the native
# app itself (iOS/Android) makes no browser-origin fetches and needs no CORS entry.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:8081,http://localhost:8083

# --- Auth (docs/specs/2026-08-28-01-auth-account-security.md) ---

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-dev-only
JWT_REFRESH_SECRET=dev-only-change-me-dev-only-change-me-dev-only

# AES-256-GCM key for encrypting users.two_factor_secret at rest — must decode to 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Email — optional. Unset = EmailService logs messages to the console instead of sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=CZ Digitizing <no-reply@czdigitizing.com>

# OAuth — optional per provider. A provider's routes return 501 until its client id/secret pair is set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Payments (docs/specs/2026-08-28-08-orders-payment-processing.md, A-013) — all optional. A provider
# with no credentials is simply unavailable at checkout (503 PAYMENT_METHOD_UNAVAILABLE); bank
# transfer always works. Real values live in your secrets manager / local .env only — never commit them.
#
# PayPal (server-side capture + webhook). Sandbox by default; set PAYPAL_API_BASE=https://api-m.paypal.com for live.
# The webhook must be registered in the PayPal dashboard for POST {API_BASE_URL}/api/webhooks/paypal
# (event PAYMENT.CAPTURE.COMPLETED) and its id put in PAYPAL_WEBHOOK_ID.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
#
# Stripe (card payments via the Payment Element, with 3-D Secure). The publishable key is public and
# is sent to the browser with the PaymentIntent client secret. The webhook endpoint is
# POST {API_BASE_URL}/api/webhooks/stripe (event payment_intent.succeeded).
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# Orders are priced in PKR. PayPal/Stripe are charged in this one currency, converted at the rate in
# the exchange_rates table when the order is created (and locked on the order). With no usable rate
# (or one older than PAYMENT_RATE_MAX_AGE_HOURS) provider payments are refused rather than guessed.
# PAYMENT_PROVIDER_CURRENCY=USD
# PAYMENT_RATE_MAX_AGE_HOURS=24
# Without EXCHANGE_RATE_API_KEY the rates are the built-in approximate fallback table — fine for
# development, NOT for charging real customers. Configure a live rate provider before going live.
# EXCHANGE_RATE_API_KEY=

# Taebo LLM matching (docs/specs/2026-08-28-15-taebo-chatbot.md, AC-7) — optional. Unset = falls
# back to the local keyword matcher. Get a key at https://openrouter.ai/keys — never commit a real
# value here or anywhere else in the repo.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
